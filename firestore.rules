rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the owner can read/write anything
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'bamou.mehdi@gmail.com';
    }

    // Publications collection
    match /publications/{slug} {
      // Public: only published documents are readable by anyone
      allow read: if resource.data.status == 'published' || isOwner();
      // Write (create, update, delete): owner only
      allow write: if isOwner();
    }
  }
}
