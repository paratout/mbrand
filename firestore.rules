rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is the admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'bamou.mehdi@gmail.com';
    }

    // Read-only access to articles/insights for everyone, write only for admin
    match /insights/{insightId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Read-only access to media for everyone, write only for admin
    match /media_appearances/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Write-only access to contact submissions (public can create, admin can read/manage)
    match /contact_submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Write-only access to newsletter signups
    match /newsletter_subscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
