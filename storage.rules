rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // All storage paths under /publications/ are publicly readable
    // (required for inline images and attachment download URLs)
    match /publications/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'bamou.mehdi@gmail.com';
    }
  }
}
